---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import GuideCard from "../../components/GuideCard.astro";
import { SITE_ORIGIN } from "../../config/release";
import { assertSampleAuditGuidesExist, sampleAuditEntryFor } from "../../lib/sampleAuditEntries";
import {
  formatDay,
  getGuides,
  guidePath,
  lastChanged,
  readingMinutes,
  type Guide,
} from "../../lib/guides";

export const getStaticPaths = (async () => {
  const guides = await getGuides();
  assertSampleAuditGuidesExist(guides.map((guide) => guide.id));
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide,
      related: guides
        .filter((other) => other.id !== guide.id && other.data.category === guide.data.category)
        .slice(0, 3),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  guide: Guide;
  related: Guide[];
}

const { guide, related } = Astro.props;
const { Content, headings } = await render(guide);
const { title, description, category, published, updated } = guide.data;
const url = new URL(guidePath(guide), SITE_ORIGIN).toString();
const minutes = readingMinutes(guide.body);
const toc = headings.filter((heading) => heading.depth === 2);
const sampleEntry = sampleAuditEntryFor(guide.id);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    articleSection: category,
    datePublished: published,
    dateModified: lastChanged(guide),
    mainEntityOfPage: url,
    url,
    author: { "@type": "Organization", name: "ScholarMark", url: `${SITE_ORIGIN}/` },
    publisher: {
      "@type": "Organization",
      name: "ScholarMark",
      url: `${SITE_ORIGIN}/`,
      logo: { "@type": "ImageObject", url: `${SITE_ORIGIN}/favicon.svg` },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_ORIGIN}/` },
      { "@type": "ListItem", position: 2, name: "Guides", item: `${SITE_ORIGIN}/guides/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={published}
  modifiedTime={lastChanged(guide)}
  jsonLd={jsonLd}
>
  <article class="guide">
    <header class="guide__header">
      <div class="container container--narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><span aria-current="page">{title}</span></li>
          </ol>
        </nav>
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="guide__meta">
          <span>Published <time datetime={published}>{formatDay(published)}</time></span>
          {
            updated && updated !== published && (
              <span>
                Updated <time datetime={updated}>{formatDay(updated)}</time>
              </span>
            )
          }
          {minutes && <span>{minutes} min read</span>}
        </p>
      </div>
    </header>

    <div class="container container--narrow guide__body">
      {
        toc.length >= 3 && (
          <nav class="toc card" aria-labelledby="toc-title">
            <h2 id="toc-title">In this guide</h2>
            <ol>
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <aside class="guide__note" aria-label="Before you submit">
        <p>
          <strong>Before you submit:</strong> check every quote, page number and citation against
          the original source, and follow your course's policy on AI-assisted work.
        </p>
      </aside>

      {
        sampleEntry && (
          <aside class="guide__sample card" aria-labelledby="guide-sample-title">
            <p class="guide__sample-tag">Synthetic example</p>
            <p class="guide__sample-title" id="guide-sample-title">
              {sampleEntry.title}
            </p>
            <p>{sampleEntry.copy}</p>
            <a href="/#sample-audit">
              Open the sample citation check <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }
    </div>
  </article>

  <div class="container guide__after">
    <CtaBand
      placement="guide"
      title="Put this guide to work on your own sources."
      copy="Start a project, upload a reading, and keep each highlight tied to its page while you draft."
    />

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">More in {category}</h2>
          <div class="related__grid">
            {related.map((item) => (
              <GuideCard guide={item} />
            ))}
          </div>
        </section>
      )
    }

    <p class="guide__back"><a href="/guides/">← All guides</a></p>
  </div>
</BaseLayout>

<style>
  .guide__header {
    padding-block: clamp(2rem, 6vw, 3.5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  .guide__header .container {
    display: grid;
    gap: 1rem;
  }

  .guide__header h1 {
    font-size: clamp(2.1rem, 5.2vw, 3.4rem);
    line-height: 1.08;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    color: var(--muted);
    font-size: 0.875rem;
    list-style: none;
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: var(--rule-strong);
  }

  .breadcrumb a {
    color: var(--muted);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--ink-soft);
  }

  .guide__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .guide__body {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 7vw, 4.5rem);
  }

  .toc {
    padding: 1.25rem 1.5rem;
  }

  .toc h2 {
    margin-bottom: 0.6rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ol {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .guide__note {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--highlight-edge);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--warn-soft);
    color: var(--ink-soft);
    font-size: 0.975rem;
  }

  .guide__sample {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    font-size: 0.975rem;
  }

  .guide__sample p {
    color: var(--ink-soft);
  }

  .guide__sample .guide__sample-tag {
    justify-self: start;
    padding: 0.05rem 0.5rem;
    border: 1px dashed var(--muted);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide__sample .guide__sample-title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .guide__sample a {
    justify-self: start;
    padding-block: 0.25rem;
    font-weight: 600;
  }

  .guide__after {
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    padding-bottom: var(--section-space);
  }

  .related {
    display: grid;
    gap: 1.25rem;
  }

  .related h2 {
    font-size: 1.5rem;
  }

  .related__grid {
    display: grid;
    gap: 1.25rem;
  }

  .guide__back {
    font-weight: 600;
  }

  @media (min-width: 44rem) {
    .related__grid {
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    }
  }
</style>
