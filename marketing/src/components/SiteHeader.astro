---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { links } from "../lib/links";

interface Props {
  /** Pathname of the current page, used to mark the active navigation item. */
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: "/#how-it-works", label: "How it works", match: null },
  { href: "/guides/", label: "Guides", match: "/guides/" },
  { href: links.pricing, label: "Pricing", match: null },
];

const isCurrent = (match: string | null) =>
  match !== null && (currentPath === match || currentPath.startsWith(match));
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={item.href}
                aria-current={isCurrent(item.match) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__actions">
        <Button href={links.signin} variant="quiet" size="sm">Sign in</Button>
        <Button href={links.signup} size="sm" signup data-cta="header">Create free account</Button>
      </div>
    </nav>

    <details class="mobile-nav">
      <summary class="mobile-nav__toggle">
        <span>Menu</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="mobile-nav__panel" aria-label="Primary mobile">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.match) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href={links.signin}>Sign in</a></li>
        </ul>
        <Button href={links.signup} signup data-cta="mobile_menu">Create free account</Button>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a link or pressing Escape, and return focus to the toggle.
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  if (menu) {
    const toggle = menu.querySelector<HTMLElement>("summary");
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest(".mobile-nav__panel a")) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        toggle?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule);
    background: rgb(250 247 241 / 92%);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .site-nav {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-nav__list {
    display: flex;
    gap: 0.25rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-deep);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .mobile-nav__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: grid;
    gap: 1rem;
    width: min(18rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-frame);
  }

  .mobile-nav__panel ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav__panel li a {
    display: block;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-nav__panel li a[aria-current="page"] {
    color: var(--accent);
  }

  @media (max-width: 52rem) {
    .site-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
