---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_ORIGIN, indexable } from "../config/release";

interface Props {
  /** Page title without the brand suffix. Omit on the homepage. */
  title?: string;
  description: string;
  type?: "website" | "article";
  /** Force noindex for pages that should never appear in search, such as 404. */
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
}

const BRAND = "ScholarMark";
const HOME_TITLE = "ScholarMark — Research workspace for source-grounded writing";

const {
  title,
  description,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const fullTitle = title ? `${title} | ${BRAND}` : HOME_TITLE;
const pageUrl = new URL(pathname, SITE_ORIGIN).toString();
const robots = indexable && !noindex ? "index, follow" : "noindex, nofollow";
// Canonical URLs only on indexable pages: a canonical next to noindex sends mixed signals.
const canonical = indexable && !noindex ? pageUrl : null;

const serializeJsonLd = (data: Record<string, unknown>) =>
  JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf7f1" />
    <meta name="color-scheme" content="light" />

    <meta property="og:site_name" content={BRAND} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? HOME_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? HOME_TITLE} />
    <meta name="twitter:description" content={description} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPath={pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/attribution.ts";
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
