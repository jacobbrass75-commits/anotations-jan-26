# Release flags are read from the build host environment, not from .env files,
# so indexing and pricing changes always come from an explicit release setting.
#
# Only "production" is indexable. Default: development (noindex, robots Disallow).
# SITE_RELEASE_ENV=production
#
# Show "Pro is $5/month" only once checkout charges $5. Default: no price shown.
# PUBLIC_PRO_PRICE_LIVE=true
